#!/bin/bash
set -eu
state=/var/lib/thinksmart-clash
stage() { printf '%s\n' "$1" > "$state/status.new"; mv "$state/status.new" "$state/status"; }
step=准备安装
tmp=$(mktemp -d)
trap 'result=$?; rm -f "$state/requests/install"; rm -rf "$tmp"; if ((result)); then stage "失败：$step"; fi' EXIT
stage "$step"
export DEBIAN_FRONTEND=noninteractive
if [[ -e "$state/apt-pending" ]]; then
    step=恢复中断的安装
    stage "$step"
    dpkg --configure --pending
    rm -f "$state/apt-pending"
fi
packages=()
for pkg in xvfb xauth x11-utils xdotool python3-dbus libayatana-appindicator3-1 python3-gi python3-yaml libglib2.0-bin dconf-cli; do
    if [[ $(dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null) != 'install ok installed' ]]; then
        packages+=("$pkg")
    fi
done
if ! command -v clash-party >/dev/null; then
    step=检查可用空间
    (( $(df -Pm / | awk 'END{print $4}') >= 1200 ))
    step=下载官方安装包
    stage "$step"
    deb=clash-party-linux-2.0.4-arm64.deb
    [[ $(dpkg --print-architecture) == arm64 ]]
    curl --fail --location --retry 3 --connect-timeout 20 --max-time 1200 -o "$tmp/$deb" "https://github.com/mihomo-party-org/clash-party/releases/download/v2.0.4/$deb"
    step=校验安装包
    stage "$step"
    echo "cc1f38075a2c4d223d80f679699b7004279e63efa12828e0e18026578731452c  $tmp/$deb" | sha256sum -c -
    packages+=("$tmp/$deb")
fi
if (( ${#packages[@]} )); then
    step=更新软件包索引
    stage "$step"
    apt-get -o Acquire::Retries=2 -o Acquire::Languages=none update --error-on=any
    step=安装应用和窗口组件
    stage "$step"
    touch "$state/apt-pending"
    apt-get -o DPkg::Lock::Timeout=90 install --no-install-recommends --no-remove -y "${packages[@]}"
    rm -f "$state/apt-pending"
fi
step=启动代理设置
stage "$step"
systemctl enable thinksmart-clash.service
systemctl restart thinksmart-clash.service
for i in {1..90}; do
    dir=/run/thinksmart-clash
    if [[ -s "$dir/tray" && -s "$dir/pid" ]] && curl -fsS --max-time 2 --unix-socket "/tmp/mihomo-party-$(id -u ubuntu)-$(cat "$dir/pid").sock" http://localhost/version >/dev/null; then
        touch "$state/panel-installed"
        stage 就绪
        exit 0
    fi
    sleep 1
done
exit 1
