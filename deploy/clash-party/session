#!/bin/bash
set -eu
dir=/run/thinksmart-clash
export XAUTHORITY="$dir/Xauthority"
touch "$XAUTHORITY"
chmod 600 "$XAUTHORITY"
xauth add :73 . "$(mcookie)"
Xvfb :73 -auth "$XAUTHORITY" -nolisten tcp -screen 0 1024x600x24 &
display=$!
for i in {1..50}; do xdpyinfo >/dev/null 2>&1 && break; sleep .2; done
xdpyinfo >/dev/null
config="${XDG_CONFIG_HOME:-$HOME/.config}/mihomo-party"
if [[ ! -e "$config/config.yaml" ]]; then
    mkdir -p "$config"
    (set -C; printf '%s\n' 'language: zh-CN' 'modeSelected: true' 'operationMode: standard' > "$config/config.yaml")
fi
/usr/bin/python3 "$(dirname "$0")/tray.py" &
watcher=$!
for i in {1..50}; do [[ -e "$dir/watcher-ready" ]] && break; sleep .1; done
[[ -e "$dir/watcher-ready" ]]
export XDG_CURRENT_DESKTOP=GNOME
clash-party --ozone-platform=x11 --disable-gpu &
app=$!
echo "$app" > "$dir/pid"
wait -n "$display" "$watcher" "$app" || true
exit 1
